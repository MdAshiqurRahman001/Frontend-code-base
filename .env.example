# ==============================================================================
# 📌 ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.

# Environment Mode (development | production)
NEXT_PUBLIC_ENV=development

# Frontend dev server port (optional)
NEXT_PUBLIC_PORT=3000

# Backend REST API Base URL (e.g. http://localhost:5000/api/v1 or https://api.yourdomain.com/api/v1)
NEXT_PUBLIC_BASE_URL=https://code-base-beta.vercel.app/api/v1
NEXT_PUBLIC_DEV_BASE_URL=https://code-base-beta.vercel.app/api/v1

# Real-time WebSocket Server URL for live chat & notifications
NEXT_PUBLIC_WS_URL=wss://code-base-beta.vercel.app
